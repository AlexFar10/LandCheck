# Copy to .env (repo root) and fill in. .env is never committed.
# Real secrets go only in .env, never in this file. Leave credential values empty here.
# Variables follow PRD Section 11.5.

# API (landcheck/api/config.py). The web dev server reads PORT too, to proxy API calls.
# HTTP port. On the shared server, use your assigned API port (docs/GETTING_STARTED.md).
PORT=3000
# Dataset folder (PRD Section 7.4 layout). Leave unset to serve the bundled SAMPLE fixture
# (landcheck/api/fixtures/sample). Once the pilot dataset exists (LC-15):
# LANDCHECK_DATASET_DIR=datasets/pilot-pechea/v1
# Comma-separated browser origins allowed to call the API. Keep empty: production serves the
# web app from the same origin, and local dev uses the Vite proxy. Only needed with VITE_API_URL:
# LANDCHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LANDCHECK_CORS_ORIGINS=
# Optional. Commit reported by GET /health when there is no .git folder (e.g. in a container).
# GIT_COMMIT=

# Web app (web/, read by Vite at dev and build time; VITE_* values end up in the browser, so no
# secrets). Optional API origin. Leave unset to use the same origin: the Vite dev proxy forwards
# /api and /health to the API on PORT. If set, the browser calls the API directly and the API
# needs LANDCHECK_CORS_ORIGINS for the web app's origin.
# VITE_API_URL=http://127.0.0.1:3000

# Offline data access only (landcheck/ core and ingest). The runtime demo never needs them.
# Placeholder names, update if needed. Server-side only: never prefix these with VITE_.
EOCUBE_USERNAME=
EOCUBE_PASSWORD=
CDSE_USERNAME=
CDSE_PASSWORD=
EGMS_USERNAME=
EGMS_PASSWORD=
