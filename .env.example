# Copy to .env (repo root) and fill in. .env is never committed.
# Real secrets go only in .env, never in this file. Leave credential values empty here.

# Satellite-data core (landcheck/). Upstream data-provider credentials.
# Placeholder names, update if needed. Server-side only: never prefix these with VITE_.
EOCUBE_USERNAME=
EOCUBE_PASSWORD=
CDSE_USERNAME=
CDSE_PASSWORD=
EGMS_USERNAME=
EGMS_PASSWORD=

# Backend (read by backend/src/landcheck/config.py)
# Comma-separated browser origins allowed to call the API.
LANDCHECK_CORS_ORIGINS=http://localhost:5173
# Folder with mock results, one file per risk. Default: contracts/mocks
# LANDCHECK_MOCKS_DIR=/path/to/contracts/mocks

# Frontend (read by Vite at dev/build time; VITE_* values end up in the browser, so no secrets)
VITE_API_URL=http://localhost:8000
